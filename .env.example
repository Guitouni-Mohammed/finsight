# FinSight — environment variables.
# Copy this file to `.env.local` (never committed) and fill in the values.
# Step-by-step guide (French): docs/SETUP.fr.md
# Never paste these values into a chat, an issue or a commit.

# --- Supabase (required) ------------------------------------------------------
# Dashboard → Project Settings → API Keys. FinSight uses Supabase from the server only (PLAN D25),
# so none of these variables has the NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (sb_publishable_…). Not secret, but only the server needs it.
SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…). SECRET: bypasses Row Level Security. Server only.
SUPABASE_SECRET_KEY=

# Public address of the app (used for the Origin check and secure cookies).
APP_URL=http://localhost:3000

# --- Rate limits (Upstash Redis) ----------------------------------------------
# Optional on your PC (an in-memory limiter is used instead), required in production.
# Upstash console → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CAPTCHA (Cloudflare Turnstile) -------------------------------------------
# Leave empty on your PC. When set, Supabase Auth must have CAPTCHA protection switched on with the
# matching secret key (Supabase dashboard → Authentication → Attack Protection).
# Cloudflare's always-pass test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Leaked-password check (Have I Been Pwned) --------------------------------
# on (default) | off. Only 5 characters of the password's SHA-1 hash leave the server.
HIBP_CHECK=on

# --- Database tests (npm run test:db) ------------------------------------------
# Connection string of your DEV project (Dashboard → Connect → Session pooler). Never production.
# DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# ALLOW_REMOTE_DB_TESTS=1
# DATABASE_CA_CERT=./prod-ca-2021.crt

# --- AI analysis (temporary: replaced by the provider-agnostic client in milestone d) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_FAST=
# OPENROUTER_MODEL_DEEP=

# --- PDF extraction (temporary: moves to the browser in milestone c) ------------
# OCR_MAX_FILE_SIZE_MB=20
# OCR_MAX_PAGES=30
# OCR_LANGUAGES=fra+eng
# OCR_CONCURRENCY=2
# OCR_SCALE=4
# OCR_FORCE=false
